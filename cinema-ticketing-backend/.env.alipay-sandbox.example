# Copy to .env.alipay-sandbox and fill your sandbox app and merchant UID.
# Native Spring Boot requires explicit import; see docs/alipay-sandbox-setup.md.
# FILE values are file paths; never paste key bodies into this template.
PAYMENT_ENABLED=false
PAYMENT_MOCK_ENABLED=false
PAYMENT_INITIALIZE_SCHEMA=true
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_APP_ID=
ALIPAY_SELLER_ID=
ALIPAY_NOTIFY_URL=
ALIPAY_RETURN_URL=http://localhost:5173/payment/result
ALIPAY_PRIVATE_KEY_FILE=E:/development/AI-Project/cinema-ticketing-backend/secrets/alipay-app-private.pem
ALIPAY_PUBLIC_KEY_FILE=E:/development/AI-Project/cinema-ticketing-backend/secrets/alipay-public.pem
# Compose host source paths for read-only secret mounts.
ALIPAY_PRIVATE_KEY_SOURCE=
ALIPAY_PUBLIC_KEY_SOURCE=
