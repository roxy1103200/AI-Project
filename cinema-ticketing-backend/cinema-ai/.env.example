JAVA_API_URL=http://127.0.0.1:8080
# Tracing is opt-in and allowed only in local/dev/test/staging/preprod environments.
AI_ENVIRONMENT=local
LANGSMITH_TRACING=false
LANGSMITH_API_KEY_FILE=../../API/langsmith.txt
LANGSMITH_PROJECT=cinema-agent-local
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# Required for organization-scoped service keys; workspace-scoped keys can omit it.
LANGSMITH_WORKSPACE_ID=
# Inputs/outputs, prompts, business rows and exception bodies are never uploaded.
AI_INTERNAL_TOKEN=local-internal-token
# Agent connects to the private Streamable HTTP MCP endpoint.
CINEMA_MCP_URL=http://127.0.0.1:8020/mcp
# Allowed HTTP Host headers for the MCP server; comma separated, no public origins.
CINEMA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,cinema-mcp:*
# Server-only key file; never put this key in VITE_* variables.
QWEN_API_KEY_FILE=../../API/qwen.txt
QWEN_MODEL=qwen3.7-flash
# Beijing endpoint; change to the matching region if needed.
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=false
QWEN_MAX_TOKENS=2048
# Rerank uses the same server-only Qwen key loader, including QWEN_API_KEY_FILE.
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
# Native DashScope API; independent of the chat completion base URL.
# A workspace-specific endpoint in the same region can be used instead.
RERANK_API_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RERANK_TOP_K=30
RERANK_TOP_N=4
RERANK_TIMEOUT_SECONDS=5
# Maximum attempted tool calls per question, including rejected/duplicate calls (1-8).
AGENT_MAX_TOOL_CALLS=4
# MySQL credentials stay in Java; only Agent connects to the private vector service.
MEMORY_ENABLED=true
CHROMA_HOST=127.0.0.1
CHROMA_PORT=8030
CHROMA_SSL=false
MEMORY_MODEL_PATH=../data/models/bge-small-zh-v1.5
