JAVA_API_URL=http://127.0.0.1:8080
AI_INTERNAL_TOKEN=local-internal-token
# Agent connects to the private Streamable HTTP MCP endpoint.
CINEMA_MCP_URL=http://127.0.0.1:8020/mcp
# Allowed HTTP Host headers for the MCP server; comma separated, no public origins.
CINEMA_MCP_ALLOWED_HOSTS=127.0.0.1:*,localhost:*,[::1]:*,cinema-mcp:*
# Server-only key file; never put this key in VITE_* variables.
QWEN_API_KEY_FILE=../../API/qwen.txt
QWEN_MODEL=qwen3.7-flash
# Beijing endpoint; change to the matching region if needed.
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ENABLE_THINKING=false
QWEN_MAX_TOKENS=2048
