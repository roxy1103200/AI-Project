<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="applicationName" source="spring.application.name" defaultValue="cinema-ticketing-backend"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [%X{traceId:-}] ${applicationName} %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="com.cinema.ticketing" level="INFO"/>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
</root>
</configuration>
