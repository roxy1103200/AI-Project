# Copy to .env; never use VITE_* for secrets.
DIFY_API_BASE_URL=https://api.dify.ai/v1
DIFY_API_KEY_FILE=../../API/dify.txt
JAVA_API_URL=http://127.0.0.1:8080
AGENT_API_URL=http://127.0.0.1:8000
# Must match Java and the internal Agent. Replace for production.
AI_INTERNAL_TOKEN=local-internal-token
# Enable when serving the site over HTTPS.
AI_COOKIE_SECURE=false
AI_MAX_STREAMS=16
# All instances must share this Redis namespace. Use the same DB as Java auth,
# or set AI_AUTH_REDIS_URL separately to Java's Redis database.
AI_REDIS_URL=redis://127.0.0.1:6379/0
AI_REDIS_PREFIX=ai:gateway:
# Local launcher worker count (Docker uses WEB_CONCURRENCY=2).
AI_GATEWAY_WORKERS=2
